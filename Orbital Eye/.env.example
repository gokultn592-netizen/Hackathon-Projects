# Oracle 21c XEPDB1 Connection Configuration
# Copy this file to .env and fill in your values

ORACLE_USER=ORBITAL_EYE
ORACLE_PASSWORD=your_password_here
ORACLE_DSN=localhost:1521/XEPDB1
ORACLE_MIN_POOL=2
ORACLE_MAX_POOL=10
ORACLE_INCREMENT=1

# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Redis Cache Configuration
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0