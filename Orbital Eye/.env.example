# =============================================================================
# OrbitalEye DBMS Edition — Environment Configuration
# Copy this file to .env:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =============================================================================

# Oracle Database Credentials
ORACLE_USER=ORBITAL_EYE
ORACLE_PASSWORD=OrbitalEye_2026
ORACLE_PASS=OrbitalEye_2026

# Oracle Database Host & Service
# 1) If running on local Windows machine directly:
ORACLE_HOST=localhost

# 2) If running via Docker with Oracle installed on your host machine:
# ORACLE_HOST=host.docker.internal

# 3) If running via Docker all-in-one container (--profile with-db):
# ORACLE_HOST=oracle

ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1

# Connection Pool Settings
ORACLE_MIN_POOL=2
ORACLE_MAX_POOL=10
ORACLE_INCREMENT=1

# FastAPI Gateway Settings
API_HOST=0.0.0.0
API_PORT=8000

# Redis Cache Settings
REDIS_ENABLED=true
REDIS_HOST=localhost
# For Docker: REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
