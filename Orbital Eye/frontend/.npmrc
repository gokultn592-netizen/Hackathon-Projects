# @react-three/drei@10.7.9 declares a peer dependency on React 19, but this project
# targets React 18.3.1 (react-dom 18.3.1, @types/react 18.3.31) and builds and runs
# correctly on it. Resolving the peer conflict with legacy-peer-deps keeps a fresh
# `npm install` reproducible instead of failing with ERESOLVE.
legacy-peer-deps=true
