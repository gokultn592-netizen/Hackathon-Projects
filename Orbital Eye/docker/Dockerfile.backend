FROM python:3.14-slim
WORKDIR /app/backend
RUN apt-get update && apt-get install -y --no-install-recommends libaio-dev libaio1 || apt-get install -y --no-install-recommends libaio1 || echo "libaio not found — continuing without" && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt fastapi uvicorn pydantic oracledb
COPY backend/ .
# The docker build context is the project root, so .env is copied from there
# (not from ../.env, which is outside the context and fails the build).
COPY .env ./.env
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]