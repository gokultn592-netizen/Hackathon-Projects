# Flood Command Center Environment Variables
# Copy this file to .env for local deployment customization

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Ingestion & Open APIs (Optional API Keys)
OPENTOPOGRAPHY_API_KEY=
NWIC_CKAN_API_KEY=

# Data Simulation Mode (Set to True for offline hackathon demo)
USE_SIMULATION=True
